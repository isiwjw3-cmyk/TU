-------------------------------------------------
-- ฟังก์ชันที่ 1 & 2: ไม้ / เหล็ก ร่วงจากฟ้าจำนวนมาก
-------------------------------------------------
task.spawn(function()
    while task.wait(0.2) do
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local pos = char.HumanoidRootPart.Position
            
            -- ระบบไม้ (Spawn Wood)
            if Wood_Enabled then
                for i = 1, 5 do -- ปล่อยลงมาครั้งละ 5 ชิ้น
                    local part = Instance.new("Part")
                    part.Size = Vector3.new(4, 1, 6)
                    part.Position = pos + Vector3.new(math.random(-30, 30), math.random(40, 70), math.random(-30, 30))
                    part.BrickColor = BrickColor.new("Reddish brown")
                    part.Material = Enum.Material.Wood
                    part.Parent = Workspace
                    table.insert(spawnedParts.Wood, part)
                end
            end
            
            -- ระบบเหล็ก (Spawn Iron)
            if Iron_Enabled then
                for i = 1, 5 do -- ปล่อยลงมาครั้งละ 5 ชิ้น
                    local part = Instance.new("Part")
                    part.Size = Vector3.new(3, 3, 3)
                    part.Position = pos + Vector3.new(math.random(-30, 30), math.random(40, 70), math.random(-30, 30))
                    part.BrickColor = BrickColor.new("Dark stone grey")
                    part.Material = Enum.Material.Metal
                    part.Parent = Workspace
                    table.insert(spawnedParts.Iron, part)
                end
            end
        end
    end
end)


-------------------------------------------------
-- ฟังก์ชันที่ 3: วิ่งเร็ว (WalkSpeed 1-300)
-------------------------------------------------
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        local humanoid = char.Humanoid
        if Speed_Enabled then
            humanoid.WalkSpeed = WalkSpeedVal
        else
            humanoid.WalkSpeed = 16 -- ค่าเริ่มต้นปกติของ Roblox
        end
    end
end)


-------------------------------------------------
-- ฟังก์ชันที่ 4: กระโดดสูงไม่จำกัด (Infinite Jump)
-------------------------------------------------
local UserInputService = game:GetService("UserInputService")

UserInputService.JumpRequest:Connect(function()
    if Jump_Enabled then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            -- ดันตัวละครขึ้นตามค่า JumpPowerVal
            hrp.Velocity = Vector3.new(hrp.Velocity.X, JumpPowerVal, hrp.Velocity.Z)
        end
    end
end)
